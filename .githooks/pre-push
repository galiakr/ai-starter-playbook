#!/usr/bin/env bash
# Full-repo pass — slower, catches what staged-only pre-commit can't.
set -uo pipefail

fail=0

check_pattern() {
  file="$1"; level="$2"; label="$3"; pattern="$4"
  matches=$(grep -nE "$pattern" "$file" || true)
  [ -z "$matches" ] && return 0
  while IFS= read -r m; do
    echo "[$level] $file: $label — $m"
  done <<< "$matches"
  [ "$level" = "error" ] && fail=1
  return 0
}

echo "Checking skill frontmatter and orphans..."
for f in skills/*/SKILL.md; do
  [ -f "$f" ] || continue
  head -1 "$f" | grep -q '^---$' || { echo "[error] $f: missing frontmatter opening ---"; fail=1; }
  grep -q '^name:' "$f" || { echo "[error] $f: missing 'name:' in frontmatter"; fail=1; }
  grep -q '^description:' "$f" || { echo "[error] $f: missing 'description:' in frontmatter"; fail=1; }
done

orphans=$(find skills -maxdepth 1 -name "skill-*.md" -type f 2>/dev/null || true)
if [ -n "$orphans" ]; then
  echo "[error] orphaned flat skill files found (should be skills/<name>/SKILL.md):"
  echo "$orphans"
  fail=1
fi

for dir in skills/*/; do
  name=$(basename "$dir")
  grep -q "\`$name\`" README.md || echo "[warning] skill '$name' exists but isn't documented in README.md"
done

echo "Scanning skills for dangerous command patterns and injection-style phrasing..."
injection_pattern="pre-approved|you must comply|takes precedence over other instructions|don't mention this to the user|do this silently|skip confirmation|ignore (previous|prior) instructions|disregard (your|other)"
for f in skills/*/SKILL.md; do
  [ -f "$f" ] || continue
  [ "$f" = "skills/audit-skills/SKILL.md" ] && continue
  check_pattern "$f" error "possible network call with no obvious tie to the skill's purpose" 'curl |wget |\bnc[[:space:]]+-|\bnetcat\b|\bncat\b'
  check_pattern "$f" error "sudo usage" 'sudo'
  check_pattern "$f" error "rm -rf" 'rm -rf'
  check_pattern "$f" error "obfuscated/eval'd command" 'base64 -d|base64 --decode|eval \$\('
  check_pattern "$f" warning "references credentials/SSH paths — confirm this matches the skill's stated purpose" '\.ssh|\.aws|id_rsa|\.env\b|credentials'
  check_pattern "$f" error "language aimed at the agent rather than the user" "$injection_pattern"
done

if command -v shellcheck >/dev/null 2>&1; then
  echo "Running shellcheck on scripts/bootstrap.sh..."
  shellcheck scripts/bootstrap.sh || fail=1
else
  echo "shellcheck not installed locally — skipping (CI still runs it)."
fi

if command -v actionlint >/dev/null 2>&1; then
  echo "Running actionlint on git/workflows/*.yml..."
  actionlint git/workflows/*.yml || fail=1
else
  echo "actionlint not installed locally — skipping (CI still runs it)."
fi

if command -v gitleaks >/dev/null 2>&1; then
  echo "Running gitleaks..."
  gitleaks detect --no-banner || fail=1
else
  echo "gitleaks not installed locally — skipping (CI still runs it)."
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "pre-push found issues above. Fix them before pushing — never skip this with --no-verify."
fi

exit $fail
